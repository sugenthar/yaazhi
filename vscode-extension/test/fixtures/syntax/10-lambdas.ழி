// லாம்டா / மூடல் — (params) => expr
இரட்டிப்பு = (x: எண்) => x * $௨
கூட்டு = (அ, ஆ) => அ + ஆ
வெற்று_லாம்டா = () => $௫
பெருக்கு = (x) => x * $௩

எண்கள் = [$௧, $௨, $௩]
// லாம்டா கால்
முடிவு = இரட்டிப்பு($௫)
அச்சிடு(முடிவு)

// கால்பேக் ஆக
சேர் தொகுப்பு
வரைபட_முடிவு = தொகுப்பு.வரைபடம்(எண்கள், (x) => x * $௨)
