{
  "comments": {
    "lineComment": "//",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"],
    ["\"", "\""]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(?:(?:பொது|தனி|பாதுகாப்பு)\\s+)?(?:செயல்|வகுப்பு|என்றால்|இல்லையென்றால்|இல்லை|வரை|ஒவ்வொரு|முயற்சி|பிழை|இறுதியில்|இடைமுகம்|எண்ணகம்)\\b.*:$",
    "decreaseIndentPattern": "^\\s*(?:இல்லையென்றால்|இல்லை|பிழை|இறுதியில்)\\b.*:$"
  },
  "wordPattern": "[\\u0B80-\\u0BFF\\w$]+",
  "folding": {
    "markers": {
      "start": "^\\s*(முயற்சி|இடைமுகம்|வகுப்பு)\\b.*:$",
      "end": "^\\s*(பிழை|இறுதியில்)\\b.*:$"
    }
  }
}
