// MongoDB அடிப்படை எடுத்துக்காட்டு
சேர் தரவுத்தளம்
சேர் சூழல்

யுஆர்ஐ = சூழல்.பெறு("YAAZHI_TEST_MONGODB_URI")
என்றால் யுஆர்ஐ == "":
    யுஆர்ஐ = "mongodb://127.0.0.1:27017"

தரவுத்தளம்_பெயர் = சூழல்.பெறு("YAAZHI_TEST_MONGODB_DATABASE")
என்றால் தரவுத்தளம்_பெயர் == "":
    தரவுத்தளம்_பெயர் = "yaazhi_test"

தரவுத்தளம்_இணைப்பு = தரவுத்தளம்.இணை("mongodb", {
    "uri": யுஆர்ஐ,
    "database": தரவுத்தளம்_பெயர்
})

அச்சிடு("MongoDB இணைக்கப்பட்டது")

சேகரிப்பு = தரவுத்தளம்_இணைப்பு.சேகரிப்பு("todos")

முடிவு = சேகரிப்பு.சேர்({
    "title": "Learn Yaazhi",
    "completed": $பொய்
})
அச்சிடு("செருகப்பட்டது")

பணிகள் = சேகரிப்பு.தேடு({})
அச்சிடு("தேடல் முடிவு")
ஒவ்வொரு பணி இல் பணிகள்:
    அச்சிடு(பணி["title"])

பணி = சேகரிப்பு.ஒன்று({"completed": $பொய்})
அச்சிடு("ஒன்று")
அச்சிடு(பணி["title"])

சேகரிப்பு.மாற்று({"completed": $பொய்}, {"$set": {"completed": $மெய்}})
அச்சிடு("மாற்றப்பட்டது")

சேகரிப்பு.நீக்கு({"completed": $மெய்})
அச்சிடு("நீக்கப்பட்டது")

அடையாளம் = தரவுத்தளம்.அடையாளம்()
அச்சிடு("புதிய அடையாளம்")
அச்சிடு(அடையாளம்.சரம்())

தரவுத்தளம்_இணைப்பு.மூடு()
அச்சிடு("MongoDB மூடப்பட்டது")
