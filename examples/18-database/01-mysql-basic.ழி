// MySQL அடிப்படை எடுத்துக்காட்டு
சேர் தரவுத்தளம்
சேர் சூழல்

ஹோஸ்ட் = சூழல்.பெறு("YAAZHI_TEST_MYSQL_HOST")
என்றால் ஹோஸ்ட் == "":
    ஹோஸ்ட் = "127.0.0.1"

தரவுத்தளம்_பெயர் = சூழல்.பெறு("YAAZHI_TEST_MYSQL_DATABASE")
என்றால் தரவுத்தளம்_பெயர் == "":
    தரவுத்தளம்_பெயர் = "yaazhi_test"

பயனர் = சூழல்.பெறு("YAAZHI_TEST_MYSQL_USER")
என்றால் பயனர் == "":
    பயனர் = "root"

கடவுச்சொல் = சூழல்.பெறு("YAAZHI_TEST_MYSQL_PASSWORD")

தரவுத்தளம்_இணைப்பு = தரவுத்தளம்.இணை("mysql", {
    "host": ஹோஸ்ட்,
    "port": $௩௩௦௬,
    "database": தரவுத்தளம்_பெயர்,
    "user": பயனர்,
    "password": கடவுச்சொல்
})

அச்சிடு("MySQL இணைக்கப்பட்டது")

தரவுத்தளம்_இணைப்பு.செயல்படுத்து("CREATE TABLE IF NOT EXISTS todos (id INT AUTO_INCREMENT PRIMARY KEY, title VARCHAR(200), completed BOOLEAN)", [])
அச்சிடு("அட்டவணை உருவாக்கப்பட்டது")

முடிவு = தரவுத்தளம்_இணைப்பு.செயல்படுத்து("INSERT INTO todos (title, completed) VALUES (?, ?)", ["Learn Yaazhi", $பொய்])
அச்சிடு("செருகப்பட்டது")
அச்சிடு(முடிவு["insertId"])
அச்சிடு(முடிவு["affectedRows"])

வரிசைகள் = தரவுத்தளம்_இணைப்பு.வினா("SELECT * FROM todos WHERE id = ?", [$௧])
அச்சிடு("வினவல் முடிவு")
ஒவ்வொரு வரிசை இல் வரிசைகள்:
    அச்சிடு(வரிசை["title"])

தரவுத்தளம்_இணைப்பு.தொடங்கு()
தரவுத்தளம்_இணைப்பு.செயல்படுத்து("INSERT INTO todos (title) VALUES (?)", ["Tx test"])
தரவுத்தளம்_இணைப்பு.பின்வாங்கு()
அச்சிடு("பரிவர்த்தனை பின்வாங்கப்பட்டது")

தரவுத்தளம்_இணைப்பு.மூடு()
அச்சிடு("MySQL மூடப்பட்டது")
